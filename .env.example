# Directory used for downloaded Azure IP range data and cache files.
DATA_DIR=/data

# Cache lifetime in seconds (7 days). Must be greater than zero.
CACHE_TTL_SECONDS=604800

# HTTPS page used to discover the current Azure IP ranges download.
DOWNLOAD_PAGE_URL=https://www.microsoft.com/en-us/download/details.aspx?id=56519

# HTTP request timeout in seconds. Must be greater than zero.
HTTP_TIMEOUT_SECONDS=30

# Number of HTTP retries after the initial attempt. Zero disables retries.
HTTP_RETRY_COUNT=3

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
